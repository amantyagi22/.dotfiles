# env
env = TERM=xterm-256color
env = COLORTERM=truecolor

# scrollback limit in bytes
scrollback-limit = 1000000

# font
# font-family = "MesloLGM Nerd Font Mono"
# font-family-bold = "MesloLGM Nerd Font Mono Bold"
# font-family-italic = "MesloLGM Nerd Font Mono Italic"
# font-family-bold-italic = "MesloLGM Nerd Font Mono Bold Italic"
font-size = 26
font-thicken = true


# window dimensions (cells)
window-width = 208
window-height = 46

# padding (pixels)
window-padding-x = 7
window-padding-y = 3

# window decoration options: auto | client | server | none
window-decoration = auto

# macOS titlebar: rounded corners on, titlebar text hidden
macos-titlebar-style = hidden

# macOS Option-as-Alt: true | false | left | right
macos-option-as-alt = true

# window-state: default | never | always
window-save-state = never

# cursor style: bar | block | underline | block_hollow
cursor-style = block
# blink: true | false | null
cursor-style-blink = true

# background opacity in range 0.0 - 1.0
# background-opacity = 0.9
# background-blur = true

theme = Rose Pine

# Ctrl+F: trigger tmux-sessionizer (fzf folder picker -> tmux session).
# Sends the command + Enter to the running shell. The \x0c (Ctrl+L / clear)
# keeps the line clean; the script itself handles in/out of tmux.
keybind = ctrl+f=text:\x15tmux-sessionizer\r

